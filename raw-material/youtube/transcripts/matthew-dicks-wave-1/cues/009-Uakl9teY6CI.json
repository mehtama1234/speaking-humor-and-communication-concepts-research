  },
  {
    "start": "00:01:27.915",
    "end": "00:01:29.775",
    "start_seconds": 87.91499999999999,
    "end_seconds": 89.775,
    "text": "I was born, I don't remember it, but"
  },
  {
    "start": "00:01:29.775",
    "end": "00:01:31.365",
    "start_seconds": 89.775,
    "end_seconds": 91.365,
    "text": "I was born and that was the beginning."
  },
  {
    "start": "00:01:31.455",
    "end": "00:01:32.625",
    "start_seconds": 91.455,
    "end_seconds": 92.625,
    "text": "I'm now somewhere in the"
  },
  {
    "start": "00:01:32.625",
    "end": "00:01:34.455",
    "start_seconds": 92.625,
    "end_seconds": 94.455,
    "text": "middle, and then theoretically,"
