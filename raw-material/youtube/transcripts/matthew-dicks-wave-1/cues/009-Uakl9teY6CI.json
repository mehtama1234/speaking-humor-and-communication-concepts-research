  {
    "start": "00:00:26.340",
    "end": "00:00:27.990",
    "start_seconds": 26.34,
    "end_seconds": 27.99,
    "text": "has a beginning, middle, and end."
  },
  {
    "start": "00:00:27.990",
    "end": "00:00:29.275",
    "start_seconds": 27.99,
    "end_seconds": 29.275,
    "text": "This morning I got dressed."
