    "end": "00:00:57.694",
    "start_seconds": 56.709,
    "end_seconds": 57.694,
    "text": "Oh, it is okay."
  },
  {
    "start": "00:00:58.025",
    "end": "00:00:58.504",
    "start_seconds": 58.025,
    "end_seconds": 58.504,
    "text": "You're not the best"
