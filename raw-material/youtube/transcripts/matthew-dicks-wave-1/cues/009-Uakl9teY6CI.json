    "start": "00:02:01.605",
    "end": "00:02:02.414",
    "start_seconds": 121.605,
    "end_seconds": 122.414,
    "text": "You thought about the"
  },
  {
    "start": "00:02:02.414",
    "end": "00:02:03.525",
    "start_seconds": 122.414,
    "end_seconds": 123.525,
    "text": "world in a different way."
  },
  {
    "start": "00:02:03.705",
    "end": "00:02:04.785",
    "start_seconds": 123.705,
    "end_seconds": 124.785,
    "text": "You thought about yourself"
  },
  {
    "start": "00:02:04.785",
    "end": "00:02:05.595",
    "start_seconds": 124.785,
    "end_seconds": 125.595,
    "text": "in a different way."
  },
  {
    "start": "00:02:05.745",
    "end": "00:02:07.455",
    "start_seconds": 125.745,
    "end_seconds": 127.455,
    "text": "You changed fundamentally"
  },
  {
    "start": "00:02:07.455",
    "end": "00:02:08.264",
    "start_seconds": 127.455,
    "end_seconds": 128.264,
    "text": "as a human being."
  },
  {
    "start": "00:02:08.625",
    "end": "00:02:11.175",
    "start_seconds": 128.625,
    "end_seconds": 131.175,
    "text": "A singular moment in time that is"
  },
  {
    "start": "00:02:11.175",
    "end": "00:02:13.365",
    "start_seconds": 131.175,
    "end_seconds": 133.365,
    "text": "wrapped around the context that"
  },
  {
    "start": "00:02:13.365",
    "end": "00:02:14.954",
    "start_seconds": 133.365,
    "end_seconds": 134.954,
    "text": "brings that singular moment to"
  },
  {
