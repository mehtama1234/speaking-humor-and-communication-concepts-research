  {
    "start": "00:00:52.810",
    "end": "00:00:53.620",
    "start_seconds": 52.81,
    "end_seconds": 53.62,
    "text": "I open it up."
  },
  {
    "start": "00:00:54.635",
    "end": "00:00:55.175",
    "start_seconds": 54.635,
    "end_seconds": 55.175,
    "text": "I take a bite."
