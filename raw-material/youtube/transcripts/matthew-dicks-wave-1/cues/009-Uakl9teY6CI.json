    "start": "00:01:25.305",
    "end": "00:01:26.475",
    "start_seconds": 85.305,
    "end_seconds": 86.475,
    "text": "want to admit to, it has a"
  },
  {
    "start": "00:01:26.475",
    "end": "00:01:27.825",
    "start_seconds": 86.475,
    "end_seconds": 87.825,
