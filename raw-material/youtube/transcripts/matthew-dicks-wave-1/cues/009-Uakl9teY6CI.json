  {
    "start": "00:00:33.190",
    "end": "00:00:34.120",
    "start_seconds": 33.19,
    "end_seconds": 34.12,
    "text": "That was the beginning."
  },
  {
    "start": "00:00:34.360",
    "end": "00:00:35.710",
    "start_seconds": 34.36,
    "end_seconds": 35.71,
    "text": "Then I put on a shirt and a pair"
