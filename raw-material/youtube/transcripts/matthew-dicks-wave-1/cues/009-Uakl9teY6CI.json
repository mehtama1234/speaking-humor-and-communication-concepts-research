    "start": "00:00:15.210",
    "end": "00:00:16.800",
    "start_seconds": 15.21,
    "end_seconds": 16.8,
    "text": "possible advice they can give you."
  },
  {
    "start": "00:00:17.010",
    "end": "00:00:18.120",
    "start_seconds": 17.01,
    "end_seconds": 18.12,
