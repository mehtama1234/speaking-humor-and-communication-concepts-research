  },
  {
    "start": "00:00:38.500",
    "end": "00:00:39.490",
    "start_seconds": 38.5,
    "end_seconds": 39.49,
    "text": "That was the end."
  },
  {
    "start": "00:00:39.640",
    "end": "00:00:41.350",
    "start_seconds": 39.64,
    "end_seconds": 41.35,
    "text": "Does it help people get dressed to know"
  },
  {
    "start": "00:00:41.350",
    "end": "00:00:42.970",
    "start_seconds": 41.35,
    "end_seconds": 42.97,
    "text": "it has a beginning, a middle, and an end."
  },
  {
    "start": "00:00:43.120",
    "end": "00:00:45.100",
    "start_seconds": 43.12,
    "end_seconds": 45.1,
    "text": "No, it doesn't help in any way whatsoever."
  },
  {
    "start": "00:00:45.280",
    "end": "00:00:46.600",
    "start_seconds": 45.28,
    "end_seconds": 46.6,
    "text": "Everything has a beginning,"
  },
  {
    "start": "00:00:46.600",
    "end": "00:00:47.440",
    "start_seconds": 46.6,
    "end_seconds": 47.44,
    "text": "a middle, and an end."
  },
  {
    "start": "00:00:47.620",
    "end": "00:00:50.170",
    "start_seconds": 47.62,
    "end_seconds": 50.17,
    "text": "A Snickers bar has a beginning,"
  },
  {
    "start": "00:00:50.170",
    "end": "00:00:51.400",
    "start_seconds": 50.17,
    "end_seconds": 51.4,
    "text": "a middle, and an end."
  },
  {
    "start": "00:00:51.640",
    "end": "00:00:52.600",
    "start_seconds": 51.64,
    "end_seconds": 52.6,
    "text": "It has a beginning."
