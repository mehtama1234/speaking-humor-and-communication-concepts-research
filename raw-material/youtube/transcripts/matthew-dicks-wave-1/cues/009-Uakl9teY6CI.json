    "start": "00:02:20.670",
    "end": "00:02:21.450",
    "start_seconds": 140.67000000000002,
    "end_seconds": 141.45,
    "text": "'cause these changes"
  },
  {
    "start": "00:02:21.450",
    "end": "00:02:22.800",
    "start_seconds": 141.45,
    "end_seconds": 142.8,
    "text": "happen instantaneously."
  },
  {
    "start": "00:02:22.890",
    "end": "00:02:24.930",
    "start_seconds": 142.89,
    "end_seconds": 144.93,
    "text": "A five second moment with the context"
  },
  {
    "start": "00:02:24.930",
    "end": "00:02:26.850",
    "start_seconds": 144.93,
    "end_seconds": 146.85,
    "text": "dropped around it to make that five"
  },
  {
    "start": "00:02:26.850",
    "end": "00:02:29.340",
    "start_seconds": 146.85,
    "end_seconds": 149.34,
    "text": "second moment as clear as possible to"
  },
  {
    "start": "00:02:29.340",
    "end": "00:02:30.690",
    "start_seconds": 149.34,
    "end_seconds": 150.69,
    "text": "the audience that you're speaking to."
  },
  {
    "start": "00:02:30.720",
    "end": "00:02:33.300",
    "start_seconds": 150.72,
    "end_seconds": 153.3,
    "text": "That is what a story is, a singular moment"
  },
  {
    "start": "00:02:33.300",
    "end": "00:02:35.280",
    "start_seconds": 153.3,
    "end_seconds": 155.28,
    "text": "in time where something changed about"
  },
  {
    "start": "00:02:35.280",
    "end": "00:02:36.835",
    "start_seconds": 155.28,
    "end_seconds": 156.835,
    "text": "you or your perception of the world."
