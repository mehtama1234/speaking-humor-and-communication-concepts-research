[
  {
    "start": "00:00:24.355",
    "end": "00:00:26.323",
    "start_seconds": 24.355,
    "end_seconds": 26.323,
    "text": "(Piano music)"
  },
  {
    "start": "00:00:41.105",
    "end": "00:00:44.475",
    "start_seconds": 41.105,
    "end_seconds": 44.475,
    "text": "I see trees"
  },
  {
    "start": "00:00:46.410",
    "end": "00:00:48.179",
    "start_seconds": 46.41,
    "end_seconds": 48.179,
    "text": "Of green"
  },
  {
    "start": "00:00:51.615",
    "end": "00:00:53.684",
    "start_seconds": 51.615,
    "end_seconds": 53.684,
    "text": "Red roses too"
  },
  {
    "start": "00:00:57.354",
    "end": "00:00:59.356",
    "start_seconds": 57.354,
    "end_seconds": 59.356,
    "text": "I see them bloom"
  },
  {
    "start": "00:01:01.425",
    "end": "00:01:04.395",
    "start_seconds": 61.425,
    "end_seconds": 64.395,
    "text": "For me and you"
  },
  {
    "start": "00:01:07.198",
    "end": "00:01:10.234",
    "start_seconds": 67.19800000000001,
    "end_seconds": 70.234,
    "text": "And I think to myself"
  },
  {
    "start": "00:01:14.505",
    "end": "00:01:18.809",
    "start_seconds": 74.505,
    "end_seconds": 78.809,
    "text": "What a wonderful world"
  },
  {
    "start": "00:01:29.153",
    "end": "00:01:31.455",
    "start_seconds": 89.15299999999999,
    "end_seconds": 91.455,
    "text": "All the colors of the rainbow"
  },
  {
    "start": "00:01:32.923",
    "end": "00:01:35.025",
    "start_seconds": 92.923,
    "end_seconds": 95.025,
    "text": "So pretty in the sky"
  },
  {
    "start": "00:01:37.094",
    "end": "00:01:42.266",
    "start_seconds": 97.094,
    "end_seconds": 102.26599999999999,
    "text": "Are also on the faces of people going by"
  },
  {
    "start": "00:01:44.268",
    "end": "00:01:49.006",
    "start_seconds": 104.268,
    "end_seconds": 109.006,
    "text": "I see friends shaking hands saying,"
  },
  {
    "start": "00:01:49.006",
    "end": "00:01:51.342",
    "start_seconds": 109.006,
    "end_seconds": 111.342,
    "text": "Saying, \"How do you do?\""
  },
  {
    "start": "00:01:53.944",
    "end": "00:01:56.614",
    "start_seconds": 113.944,
    "end_seconds": 116.614,
    "text": "They're really saying"
  },
  {
    "start": "00:01:58.215",
    "end": "00:02:01.252",
    "start_seconds": 118.215,
    "end_seconds": 121.252,
    "text": "I love you"
  },
  {
    "start": "00:02:15.199",
    "end": "00:02:19.436",
    "start_seconds": 135.199,
    "end_seconds": 139.436,
    "text": "I hear babies crying"
  },
  {
    "start": "00:02:22.873",
    "end": "00:02:25.075",
    "start_seconds": 142.873,
    "end_seconds": 145.075,
    "text": "I watch them grow"
  },
  {
    "start": "00:02:26.510",
    "end": "00:02:33.317",
    "start_seconds": 146.51,
    "end_seconds": 153.317,
    "text": "They'll know much more than I'll ever know"
  },
  {
    "start": "00:02:38.756",
    "end": "00:02:42.860",
    "start_seconds": 158.756,
    "end_seconds": 162.86,
    "text": "And I think to myself"
  },
  {
    "start": "00:02:46.897",
    "end": "00:02:50.901",
    "start_seconds": 166.897,
    "end_seconds": 170.901,
    "text": "What a wonderful"
  },
  {
    "start": "00:02:54.505",
    "end": "00:02:56.240",
    "start_seconds": 174.505,
    "end_seconds": 176.24,
    "text": "World"
  },
  {
    "start": "00:03:06.083",
    "end": "00:03:08.485",
    "start_seconds": 186.083,
    "end_seconds": 188.485,
    "text": "(Music ends)"
  },
  {
    "start": "00:03:09.787",
    "end": "00:03:16.660",
    "start_seconds": 189.787,
    "end_seconds": 196.66,
    "text": "(Applause and cheers)"
  },
  {
    "start": "00:03:18.295",
    "end": "00:03:20.164",
    "start_seconds": 198.29500000000002,
    "end_seconds": 200.164,
    "text": "Thank you very much, everybody."
  },
  {
    "start": "00:03:20.731",
    "end": "00:03:22.299",
    "start_seconds": 200.731,
    "end_seconds": 202.299,
    "text": "Isn't that a beautiful song?"
  },
  {
    "start": "00:03:22.700",
    "end": "00:03:24.034",
    "start_seconds": 202.7,
    "end_seconds": 204.034,
    "text": "I just love it."
  },
  {
    "start": "00:03:24.034",
    "end": "00:03:27.271",
    "start_seconds": 204.034,
    "end_seconds": 207.27100000000002,
    "text": "You know, music is a language you already know."
  },
  {
    "start": "00:03:27.271",
    "end": "00:03:29.940",
    "start_seconds": 207.27100000000002,
    "end_seconds": 209.94,
    "text": "And there's something deeply powerful that happens"
  },
  {
    "start": "00:03:29.974",
    "end": "00:03:31.742",
    "start_seconds": 209.974,
    "end_seconds": 211.742,
    "text": "when we come together to make it."
  },
  {
    "start": "00:03:31.775",
    "end": "00:03:33.277",
    "start_seconds": 211.775,
    "end_seconds": 213.277,
    "text": "Something connective,"
  },
  {
    "start": "00:03:33.310",
    "end": "00:03:36.513",
    "start_seconds": 213.31,
    "end_seconds": 216.513,
    "text": "something transformative, something vibrational."
  },
  {
    "start": "00:03:36.513",
    "end": "00:03:38.315",
    "start_seconds": 216.513,
    "end_seconds": 218.315,
    "text": "It's a feeling that moves us."
  },
  {
    "start": "00:03:38.349",
    "end": "00:03:40.718",
    "start_seconds": 218.349,
    "end_seconds": 220.71800000000002,
    "text": "Now I have a name for this feeling."
  },
  {
    "start": "00:03:41.552",
    "end": "00:03:44.088",
    "start_seconds": 221.552,
    "end_seconds": 224.088,
    "text": "I call it the wiggle."
  },
  {
    "start": "00:03:44.455",
    "end": "00:03:45.689",
    "start_seconds": 224.45499999999998,
    "end_seconds": 225.689,
    "text": "(Laughter)"
  },
  {
    "start": "00:03:46.790",
    "end": "00:03:49.827",
    "start_seconds": 226.79,
    "end_seconds": 229.827,
    "text": "Now what’s the difference between a wiggle and a straight line?"
  },
  {
    "start": "00:03:49.827",
    "end": "00:03:52.763",
    "start_seconds": 229.827,
    "end_seconds": 232.763,
    "text": "Well we all know how a straight line feels, right?"
  },
  {
    "start": "00:03:52.796",
    "end": "00:03:54.465",
    "start_seconds": 232.796,
    "end_seconds": 234.465,
    "text": "Rigid, unyielding,"
  },
  {
    "start": "00:03:54.498",
    "end": "00:03:56.433",
    "start_seconds": 234.498,
    "end_seconds": 236.433,
    "text": "inflexible, linear."
  },
  {
    "start": "00:03:56.467",
    "end": "00:03:58.669",
    "start_seconds": 236.46699999999998,
    "end_seconds": 238.66899999999998,
    "text": "Like a Roman road or the hand of a clock."
  },
  {
    "start": "00:03:58.702",
    "end": "00:04:00.604",
    "start_seconds": 238.702,
    "end_seconds": 240.604,
    "text": "It's set, it's certain."
  },
  {
    "start": "00:04:01.739",
    "end": "00:04:06.410",
    "start_seconds": 241.739,
    "end_seconds": 246.41,
    "text": "But the wiggle, on the other hand, is soft and flexible and fluid."
  },
  {
    "start": "00:04:06.877",
    "end": "00:04:10.381",
    "start_seconds": 246.877,
    "end_seconds": 250.381,
    "text": "The wiggle is smooth and constantly in motion, right?"
  },
  {
    "start": "00:04:11.048",
    "end": "00:04:13.984",
    "start_seconds": 251.048,
    "end_seconds": 253.984,
    "text": "So where the straight line is firm and brittle,"
  },
  {
    "start": "00:04:14.018",
    "end": "00:04:16.320",
    "start_seconds": 254.018,
    "end_seconds": 256.32,
    "text": "the wiggle is supple and resilient --"
  },
  {
    "start": "00:04:16.320",
    "end": "00:04:18.922",
    "start_seconds": 256.32,
    "end_seconds": 258.922,
    "text": "like water -- constantly changing shape,"
  },
  {
    "start": "00:04:18.956",
    "end": "00:04:21.225",
    "start_seconds": 258.956,
    "end_seconds": 261.225,
    "text": "but stronger than almost anything."
  },
  {
    "start": "00:04:21.258",
    "end": "00:04:25.663",
    "start_seconds": 261.258,
    "end_seconds": 265.663,
    "text": "As the great Alan Watts used to say, there are no straight lines in nature."
  },
  {
    "start": "00:04:26.630",
    "end": "00:04:30.267",
    "start_seconds": 266.63,
    "end_seconds": 270.267,
    "text": "Now I've learned many of the principles of wiggledom"
  },
  {
    "start": "00:04:30.267",
    "end": "00:04:32.002",
    "start_seconds": 270.267,
    "end_seconds": 272.002,
    "text": "through the process of making music"
  },
  {
    "start": "00:04:32.036",
    "end": "00:04:34.371",
    "start_seconds": 272.036,
    "end_seconds": 274.371,
    "text": "because music is inherently wiggly."
  },
  {
    "start": "00:04:34.405",
    "end": "00:04:37.274",
    "start_seconds": 274.405,
    "end_seconds": 277.274,
    "text": "Music is made out of a bunch of those things, there."
  },
  {
    "start": "00:04:37.308",
    "end": "00:04:39.877",
    "start_seconds": 277.308,
    "end_seconds": 279.877,
    "text": "Essentially, music is just wiggling air."
  },
  {
    "start": "00:04:39.910",
    "end": "00:04:41.545",
    "start_seconds": 279.90999999999997,
    "end_seconds": 281.545,
    "text": "That's what's going on with music."
  },
  {
    "start": "00:04:41.578",
    "end": "00:04:42.846",
    "start_seconds": 281.578,
    "end_seconds": 282.846,
    "text": "And as musicians,"
  },
  {
    "start": "00:04:42.846",
    "end": "00:04:46.083",
    "start_seconds": 282.846,
    "end_seconds": 286.08299999999997,
    "text": "we are constantly oscillating between different states, right?"
  },
  {
    "start": "00:04:46.116",
    "end": "00:04:48.619",
    "start_seconds": 286.116,
    "end_seconds": 288.619,
    "text": "So high to low"
  },
  {
    "start": "00:04:48.652",
    "end": "00:04:50.954",
    "start_seconds": 288.652,
    "end_seconds": 290.954,
    "text": "Or loud to quiet."
  },
  {
    "start": "00:04:52.122",
    "end": "00:04:55.426",
    "start_seconds": 292.122,
    "end_seconds": 295.426,
    "text": "Thick to thin."
  },
  {
    "start": "00:04:57.294",
    "end": "00:04:59.229",
    "start_seconds": 297.294,
    "end_seconds": 299.229,
    "text": "Music is constantly in motion."
  },
  {
    "start": "00:04:59.263",
    "end": "00:05:02.032",
    "start_seconds": 299.263,
    "end_seconds": 302.032,
    "text": "And everything in music is learned through play."
  },
  {
    "start": "00:05:02.533",
    "end": "00:05:06.470",
    "start_seconds": 302.533,
    "end_seconds": 306.47,
    "text": "Now there are three essential types of wiggle in music"
  },
  {
    "start": "00:05:06.503",
    "end": "00:05:08.472",
    "start_seconds": 306.503,
    "end_seconds": 308.472,
    "text": "that I'd like to talk to you about today."
  },
  {
    "start": "00:05:08.472",
    "end": "00:05:10.741",
    "start_seconds": 308.472,
    "end_seconds": 310.741,
    "text": "The first is called melody, what we call melody."
  },
  {
    "start": "00:05:10.774",
    "end": "00:05:14.078",
    "start_seconds": 310.774,
    "end_seconds": 314.078,
    "text": "Now a melody draws a line from one place to another"
  },
  {
    "start": "00:05:14.078",
    "end": "00:05:16.080",
    "start_seconds": 314.078,
    "end_seconds": 316.08,
    "text": "and tells a story as it goes."
  },
  {
    "start": "00:05:16.080",
    "end": "00:05:20.084",
    "start_seconds": 316.08,
    "end_seconds": 320.084,
    "text": "So Louis Armstrong walks down the street, looks around and he goes,"
  },
  {
    "start": "00:05:20.117",
    "end": "00:05:21.819",
    "start_seconds": 320.117,
    "end_seconds": 321.819,
    "text": "\"I see trees of green.\""
  },
  {
    "start": "00:05:21.852",
    "end": "00:05:23.087",
    "start_seconds": 321.852,
    "end_seconds": 323.087,
    "text": "Yeah?"
  },
  {
    "start": "00:05:23.087",
    "end": "00:05:25.422",
    "start_seconds": 323.087,
    "end_seconds": 325.422,
    "text": "Not, \"I see trees of green.\""
  },
  {
    "start": "00:05:25.456",
    "end": "00:05:26.657",
    "start_seconds": 325.456,
    "end_seconds": 326.657,
    "text": "Not that."
  },
  {
    "start": "00:05:26.657",
    "end": "00:05:28.359",
    "start_seconds": 326.657,
    "end_seconds": 328.359,
    "text": "\"I see trees of green.\""
  },
  {
    "start": "00:05:28.792",
    "end": "00:05:30.027",
    "start_seconds": 328.79200000000003,
    "end_seconds": 330.027,
    "text": "It's a tree."
  },
  {
    "start": "00:05:30.594",
    "end": "00:05:32.663",
    "start_seconds": 330.594,
    "end_seconds": 332.663,
    "text": "\"I see skies are blue.\""
  },
  {
    "start": "00:05:33.063",
    "end": "00:05:34.665",
    "start_seconds": 333.063,
    "end_seconds": 334.665,
    "text": "It's the sky, right?"
  },
  {
    "start": "00:05:35.199",
    "end": "00:05:37.935",
    "start_seconds": 335.199,
    "end_seconds": 337.935,
    "text": "\"Clouds are white,\" there's a little cloud up there."
  },
  {
    "start": "00:05:38.402",
    "end": "00:05:39.737",
    "start_seconds": 338.402,
    "end_seconds": 339.737,
    "text": "\"The bright blessed day,"
  },
  {
    "start": "00:05:39.737",
    "end": "00:05:41.038",
    "start_seconds": 339.737,
    "end_seconds": 341.038,
    "text": "The dark sacred night.\""
  },
  {
    "start": "00:05:41.038",
    "end": "00:05:42.873",
    "start_seconds": 341.038,
    "end_seconds": 342.873,
    "text": "Is that not the sun going down?"
  },
  {
    "start": "00:05:42.906",
    "end": "00:05:44.408",
    "start_seconds": 342.906,
    "end_seconds": 344.408,
    "text": "It is."
  },
  {
    "start": "00:05:44.441",
    "end": "00:05:47.578",
    "start_seconds": 344.44100000000003,
    "end_seconds": 347.578,
    "text": "A good melody arc tells a story and draws a line that moves us."
  },
  {
    "start": "00:05:47.611",
    "end": "00:05:49.546",
    "start_seconds": 347.611,
    "end_seconds": 349.546,
    "text": "That's the first kind of wiggle."
  },
  {
    "start": "00:05:49.980",
    "end": "00:05:53.417",
    "start_seconds": 349.98,
    "end_seconds": 353.41700000000003,
    "text": "Now the second kind of wiggle is what they call rhythm."
  },
  {
    "start": "00:05:53.417",
    "end": "00:05:57.054",
    "start_seconds": 353.41700000000003,
    "end_seconds": 357.054,
    "text": "Now rhythm is about time, but it's also about the body."
  },
  {
    "start": "00:05:57.087",
    "end": "00:05:58.589",
    "start_seconds": 357.087,
    "end_seconds": 358.589,
    "text": "So Louis does not sing this:"
  },
  {
    "start": "00:05:58.622",
    "end": "00:06:00.157",
    "start_seconds": 358.622,
    "end_seconds": 360.157,
    "text": "\"I see trees of green."
  },
  {
    "start": "00:06:00.190",
    "end": "00:06:02.726",
    "start_seconds": 360.19,
    "end_seconds": 362.726,
    "text": "Red roses too, I see --\""
  },
  {
    "start": "00:06:02.760",
    "end": "00:06:04.061",
    "start_seconds": 362.76,
    "end_seconds": 364.061,
    "text": "No, sir."
  },
  {
    "start": "00:06:04.395",
    "end": "00:06:06.864",
    "start_seconds": 364.395,
    "end_seconds": 366.864,
    "text": "Instead he goes, \"I see trees green.\""
  },
  {
    "start": "00:06:06.897",
    "end": "00:06:10.200",
    "start_seconds": 366.897,
    "end_seconds": 370.2,
    "text": "(Vocalizing)"
  },
  {
    "start": "00:06:11.335",
    "end": "00:06:12.603",
    "start_seconds": 371.335,
    "end_seconds": 372.603,
    "text": "Right?"
  },
  {
    "start": "00:06:12.603",
    "end": "00:06:14.271",
    "start_seconds": 372.603,
    "end_seconds": 374.271,
    "text": "I just saw a bunch of you do this."
  },
  {
    "start": "00:06:14.938",
    "end": "00:06:17.808",
    "start_seconds": 374.938,
    "end_seconds": 377.808,
    "text": "Rhythm physically moves the body."
  },
  {
    "start": "00:06:17.808",
    "end": "00:06:19.443",
    "start_seconds": 377.808,
    "end_seconds": 379.443,
    "text": "And with that motion and play,"
  },
  {
    "start": "00:06:19.476",
    "end": "00:06:21.945",
    "start_seconds": 379.476,
    "end_seconds": 381.945,
    "text": "the melody has something to be in conversation with."
  },
  {
    "start": "00:06:21.979",
    "end": "00:06:23.480",
    "start_seconds": 381.979,
    "end_seconds": 383.48,
    "text": "And suddenly we have space,"
  },
  {
    "start": "00:06:23.480",
    "end": "00:06:26.450",
    "start_seconds": 383.48,
    "end_seconds": 386.45,
    "text": "and we have form, and we have proportion and dynamics"
  },
  {
    "start": "00:06:26.450",
    "end": "00:06:28.419",
    "start_seconds": 386.45,
    "end_seconds": 388.419,
    "text": "and that kind of storytelling."
  },
  {
    "start": "00:06:28.452",
    "end": "00:06:29.753",
    "start_seconds": 388.452,
    "end_seconds": 389.753,
    "text": "It's beautiful."
  },
  {
    "start": "00:06:29.787",
    "end": "00:06:32.856",
    "start_seconds": 389.787,
    "end_seconds": 392.856,
    "text": "So rhythm moves us and our melody through time."
  },
  {
    "start": "00:06:32.890",
    "end": "00:06:34.758",
    "start_seconds": 392.89,
    "end_seconds": 394.758,
    "text": "That's the second kind of wiggle."
  },
  {
    "start": "00:06:34.792",
    "end": "00:06:38.495",
    "start_seconds": 394.79200000000003,
    "end_seconds": 398.495,
    "text": "Now the third kind of wiggle is my personal favorite,"
  },
  {
    "start": "00:06:38.529",
    "end": "00:06:40.497",
    "start_seconds": 398.529,
    "end_seconds": 400.497,
    "text": "and it's what they call harmony."
  },
  {
    "start": "00:06:40.497",
    "end": "00:06:43.167",
    "start_seconds": 400.497,
    "end_seconds": 403.16700000000003,
    "text": "Now harmony is about relationships."
  },
  {
    "start": "00:06:43.534",
    "end": "00:06:45.469",
    "start_seconds": 403.534,
    "end_seconds": 405.469,
    "text": "It's the wiggles between the wiggles."
  },
  {
    "start": "00:06:45.936",
    "end": "00:06:48.672",
    "start_seconds": 405.936,
    "end_seconds": 408.672,
    "text": "And by adding these chords, little combinations of notes,"
  },
  {
    "start": "00:06:48.705",
    "end": "00:06:50.274",
    "start_seconds": 408.705,
    "end_seconds": 410.274,
    "text": "like clusters of notes,"
  },
  {
    "start": "00:06:50.274",
    "end": "00:06:53.076",
    "start_seconds": 410.274,
    "end_seconds": 413.076,
    "text": "we get to take our melody and our rhythm"
  },
  {
    "start": "00:06:53.110",
    "end": "00:06:55.913",
    "start_seconds": 413.11,
    "end_seconds": 415.913,
    "text": "and decide how we want these things to feel."
  },
  {
    "start": "00:06:55.946",
    "end": "00:06:59.349",
    "start_seconds": 415.946,
    "end_seconds": 419.349,
    "text": "OK, so with this song, we start home."
  },
  {
    "start": "00:06:59.383",
    "end": "00:07:01.351",
    "start_seconds": 419.383,
    "end_seconds": 421.351,
    "text": "We begin home, right?"
  },
  {
    "start": "00:07:04.655",
    "end": "00:07:05.923",
    "start_seconds": 424.655,
    "end_seconds": 425.923,
    "text": "Begin to move."
  },
  {
    "start": "00:07:07.524",
    "end": "00:07:09.526",
    "start_seconds": 427.524,
    "end_seconds": 429.526,
    "text": "Somewhere close by, quite warm."
  },
  {
    "start": "00:07:11.562",
    "end": "00:07:12.896",
    "start_seconds": 431.562,
    "end_seconds": 432.896,
    "text": "A bit of darkness there."
  },
  {
    "start": "00:07:14.998",
    "end": "00:07:16.266",
    "start_seconds": 434.998,
    "end_seconds": 436.266,
    "text": "Lightening."
  },
  {
    "start": "00:07:17.334",
    "end": "00:07:18.469",
    "start_seconds": 437.334,
    "end_seconds": 438.469,
    "text": "Saddening."
  },
  {
    "start": "00:07:19.403",
    "end": "00:07:21.438",
    "start_seconds": 439.403,
    "end_seconds": 441.438,
    "text": "And then something extraordinary happens."
  },
  {
    "start": "00:07:21.805",
    "end": "00:07:23.874",
    "start_seconds": 441.805,
    "end_seconds": 443.874,
    "text": "Our melody note stays the same."
  },
  {
    "start": "00:07:23.907",
    "end": "00:07:26.944",
    "start_seconds": 443.907,
    "end_seconds": 446.944,
    "text": "\"And I think to myself,\" right, one melody note."
  },
  {
    "start": "00:07:27.411",
    "end": "00:07:30.514",
    "start_seconds": 447.411,
    "end_seconds": 450.514,
    "text": "But the chord, which could happily stay here,"
  },
  {
    "start": "00:07:30.547",
    "end": "00:07:31.748",
    "start_seconds": 450.547,
    "end_seconds": 451.748,
    "text": "becomes this."
  },
  {
    "start": "00:07:31.782",
    "end": "00:07:36.320",
    "start_seconds": 451.782,
    "end_seconds": 456.32,
    "text": "\"And I think to myself,\" did you feel the wiggle?"
  },
  {
    "start": "00:07:37.020",
    "end": "00:07:38.288",
    "start_seconds": 457.02,
    "end_seconds": 458.288,
    "text": "It's special, isn't it?"
  },
  {
    "start": "00:07:38.322",
    "end": "00:07:41.258",
    "start_seconds": 458.322,
    "end_seconds": 461.258,
    "text": "This note just completely changed color."
  },
  {
    "start": "00:07:42.759",
    "end": "00:07:43.894",
    "start_seconds": 462.759,
    "end_seconds": 463.894,
    "text": "Didn't it?"
  },
  {
    "start": "00:07:43.927",
    "end": "00:07:45.462",
    "start_seconds": 463.927,
    "end_seconds": 465.462,
    "text": "That's the power of harmony."
  },
  {
    "start": "00:07:45.496",
    "end": "00:07:48.298",
    "start_seconds": 465.496,
    "end_seconds": 468.298,
    "text": "So with a chord, I can squint,"
  },
  {
    "start": "00:07:48.332",
    "end": "00:07:50.267",
    "start_seconds": 468.332,
    "end_seconds": 470.267,
    "text": "I can reassure,"
  },
  {
    "start": "00:07:50.300",
    "end": "00:07:52.503",
    "start_seconds": 470.3,
    "end_seconds": 472.503,
    "text": "I can enchant,"
  },
  {
    "start": "00:07:52.536",
    "end": "00:07:55.572",
    "start_seconds": 472.536,
    "end_seconds": 475.572,
    "text": "I can purify,"
  },
  {
    "start": "00:07:55.606",
    "end": "00:07:57.040",
    "start_seconds": 475.606,
    "end_seconds": 477.04,
    "text": "I can terrify."
  },
  {
    "start": "00:07:59.643",
    "end": "00:08:01.678",
    "start_seconds": 479.64300000000003,
    "end_seconds": 481.678,
    "text": "So that when I get home, in the end ..."
  },
  {
    "start": "00:08:04.114",
    "end": "00:08:07.217",
    "start_seconds": 484.114,
    "end_seconds": 487.217,
    "text": "It’s all the more beautiful because we’ve traveled somewhere new."
  },
  {
    "start": "00:08:07.251",
    "end": "00:08:09.152",
    "start_seconds": 487.251,
    "end_seconds": 489.152,
    "text": "Harmony tells an emotional story"
  },
  {
    "start": "00:08:09.186",
    "end": "00:08:11.622",
    "start_seconds": 489.186,
    "end_seconds": 491.622,
    "text": "through tension, release, dissonance and consonance"
  },
  {
    "start": "00:08:11.655",
    "end": "00:08:14.358",
    "start_seconds": 491.655,
    "end_seconds": 494.358,
    "text": "by combining many different notes together."
  },
  {
    "start": "00:08:14.391",
    "end": "00:08:15.859",
    "start_seconds": 494.391,
    "end_seconds": 495.859,
    "text": "That's the third wiggle."
  },
  {
    "start": "00:08:15.893",
    "end": "00:08:19.463",
    "start_seconds": 495.89300000000003,
    "end_seconds": 499.463,
    "text": "So you may say, “But Jacob, why does it make us wiggle so?"
  },
  {
    "start": "00:08:19.997",
    "end": "00:08:22.466",
    "start_seconds": 499.997,
    "end_seconds": 502.466,
    "text": "How do these notes make us feel these things?”"
  },
  {
    "start": "00:08:22.499",
    "end": "00:08:26.036",
    "start_seconds": 502.499,
    "end_seconds": 506.036,
    "text": "And I would say, well, because music is about so much more than just notes."
  },
  {
    "start": "00:08:26.036",
    "end": "00:08:27.604",
    "start_seconds": 506.036,
    "end_seconds": 507.604,
    "text": "Music is about life."
  },
  {
    "start": "00:08:27.638",
    "end": "00:08:30.607",
    "start_seconds": 507.638,
    "end_seconds": 510.60699999999997,
    "text": "In music, we learn that being in harmony with the world"
  },
  {
    "start": "00:08:30.641",
    "end": "00:08:33.677",
    "start_seconds": 510.641,
    "end_seconds": 513.677,
    "text": "doesn't mean everyone is singing the same note at the same time."
  },
  {
    "start": "00:08:33.677",
    "end": "00:08:36.947",
    "start_seconds": 513.677,
    "end_seconds": 516.947,
    "text": "It's about embracing the dissonance and following the heart to home."
  },
  {
    "start": "00:08:37.548",
    "end": "00:08:39.816",
    "start_seconds": 517.548,
    "end_seconds": 519.816,
    "text": "We learn that being in time with the world"
  },
  {
    "start": "00:08:39.850",
    "end": "00:08:41.852",
    "start_seconds": 519.85,
    "end_seconds": 521.852,
    "text": "doesn't have to mean stepping into line."
  },
  {
    "start": "00:08:41.852",
    "end": "00:08:44.755",
    "start_seconds": 521.852,
    "end_seconds": 524.755,
    "text": "It's about motion and knowing when your time is right."
  },
  {
    "start": "00:08:44.788",
    "end": "00:08:46.623",
    "start_seconds": 524.788,
    "end_seconds": 526.623,
    "text": "Leaving space for the rest."
  },
  {
    "start": "00:08:46.957",
    "end": "00:08:50.427",
    "start_seconds": 526.957,
    "end_seconds": 530.427,
    "text": "We learn that being in tune is not about being perfect."
  },
  {
    "start": "00:08:50.928",
    "end": "00:08:52.462",
    "start_seconds": 530.928,
    "end_seconds": 532.462,
    "text": "It's about following a line"
  },
  {
    "start": "00:08:52.496",
    "end": "00:08:54.531",
    "start_seconds": 532.496,
    "end_seconds": 534.531,
    "text": "and being open to where it might take you."
  },
  {
    "start": "00:08:54.531",
    "end": "00:08:56.300",
    "start_seconds": 534.531,
    "end_seconds": 536.3,
    "text": "Because here's the truth of it."
  },
  {
    "start": "00:08:56.333",
    "end": "00:08:58.569",
    "start_seconds": 536.333,
    "end_seconds": 538.569,
    "text": "Life does not work in straight lines."
  },
  {
    "start": "00:08:58.602",
    "end": "00:09:01.605",
    "start_seconds": 538.602,
    "end_seconds": 541.605,
    "text": "Life is full of curveballs, full of ups and downs."
  },
  {
    "start": "00:09:01.638",
    "end": "00:09:04.408",
    "start_seconds": 541.638,
    "end_seconds": 544.408,
    "text": "And either we yield and we bend and we soften."
  },
  {
    "start": "00:09:04.875",
    "end": "00:09:06.843",
    "start_seconds": 544.875,
    "end_seconds": 546.843,
    "text": "Or we stiffen up and we break."
  },
  {
    "start": "00:09:07.411",
    "end": "00:09:09.746",
    "start_seconds": 547.411,
    "end_seconds": 549.746,
    "text": "So when the world feels like a straight line,"
  },
  {
    "start": "00:09:09.780",
    "end": "00:09:11.081",
    "start_seconds": 549.78,
    "end_seconds": 551.081,
    "text": "be a wiggler."
  },
  {
    "start": "00:09:11.114",
    "end": "00:09:12.549",
    "start_seconds": 551.114,
    "end_seconds": 552.549,
    "text": "It's in your nature, trust me."
  },
  {
    "start": "00:09:12.583",
    "end": "00:09:14.318",
    "start_seconds": 552.583,
    "end_seconds": 554.318,
    "text": "You already know how to wiggle."
  },
  {
    "start": "00:09:15.452",
    "end": "00:09:16.954",
    "start_seconds": 555.452,
    "end_seconds": 556.954,
    "text": "You just need to remember."
  },
  {
    "start": "00:09:17.988",
    "end": "00:09:20.390",
    "start_seconds": 557.988,
    "end_seconds": 560.39,
    "text": "(Piano music)"
  },
  {
    "start": "00:09:34.037",
    "end": "00:09:36.039",
    "start_seconds": 574.037,
    "end_seconds": 576.039,
    "text": "I think to myself,"
  },
  {
    "start": "00:09:37.307",
    "end": "00:09:41.612",
    "start_seconds": 577.307,
    "end_seconds": 581.612,
    "text": "What a wonderful world"
  },
  {
    "start": "00:09:46.583",
    "end": "00:09:48.085",
    "start_seconds": 586.583,
    "end_seconds": 588.085,
    "text": "Yes"
  },
  {
    "start": "00:09:49.486",
    "end": "00:09:51.989",
    "start_seconds": 589.486,
    "end_seconds": 591.989,
    "text": "I think to myself"
  },
  {
    "start": "00:09:57.694",
    "end": "00:10:01.865",
    "start_seconds": 597.694,
    "end_seconds": 601.865,
    "text": "What a wonderful"
  },
  {
    "start": "00:10:06.069",
    "end": "00:10:08.205",
    "start_seconds": 606.069,
    "end_seconds": 608.205,
    "text": "World"
  },
  {
    "start": "00:10:08.238",
    "end": "00:10:10.073",
    "start_seconds": 608.238,
    "end_seconds": 610.073,
    "text": "World"
  },
  {
    "start": "00:10:10.073",
    "end": "00:10:11.608",
    "start_seconds": 610.073,
    "end_seconds": 611.608,
    "text": "World"
  },
  {
    "start": "00:10:11.642",
    "end": "00:10:14.645",
    "start_seconds": 611.642,
    "end_seconds": 614.645,
    "text": "(Audience sings)"
  },
  {
    "start": "00:10:16.947",
    "end": "00:10:18.148",
    "start_seconds": 616.947,
    "end_seconds": 618.148,
    "text": "(Singing ends)"
  },
  {
    "start": "00:10:19.383",
    "end": "00:10:26.323",
    "start_seconds": 619.383,
    "end_seconds": 626.323,
    "text": "(Cheers and applause)"
  }
]
