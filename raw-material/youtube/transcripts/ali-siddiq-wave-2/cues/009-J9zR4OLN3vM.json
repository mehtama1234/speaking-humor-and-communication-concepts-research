  },
  {
    "start": "00:04:02.950",
    "end": "00:04:02.960",
    "start_seconds": 242.95,
    "end_seconds": 242.96,
    "text": "to view the caskets?\""
  },
  {
    "start": "00:04:02.960",
    "end": "00:04:06.390",
    "start_seconds": 242.96,
    "end_seconds": 246.39,
    "text": "to view the caskets?\" I said, \"I am.\""
  },
  {
    "start": "00:04:06.400",
    "end": "00:04:08.510",
    "start_seconds": 246.4,
    "end_seconds": 248.51,
    "text": "She said, \"Marcus,"
  },
  {
    "start": "00:04:08.510",
    "end": "00:04:08.520",
    "start_seconds": 248.51,
    "end_seconds": 248.52,
    "text": "She said, \"Marcus,"
  },
  {
    "start": "00:04:08.520",
    "end": "00:04:10.949",
    "start_seconds": 248.52,
    "end_seconds": 250.949,
    "text": "She said, \"Marcus, you know your father"
  },
  {
    "start": "00:04:10.949",
    "end": "00:04:10.959",
    "start_seconds": 250.949,
    "end_seconds": 250.959,
    "text": "you know your father"
  },
  {
    "start": "00:04:10.959",
    "end": "00:04:15.442",
    "start_seconds": 250.959,
    "end_seconds": 255.442,
    "text": "you know your father was a first-class man.\""
  },
  {
    "start": "00:04:15.452",
    "end": "00:04:17.670",
    "start_seconds": 255.452,
    "end_seconds": 257.67,
    "text": ">> [laughter]"
  },
  {
    "start": "00:04:17.680",
    "end": "00:04:19.990",
    "start_seconds": 257.68,
    "end_seconds": 259.99,
    "text": ">> She said, \"Marcus, you know your father"
  },
  {
    "start": "00:04:19.990",
    "end": "00:04:20.000",
    "start_seconds": 259.99,
    "end_seconds": 260.0,
    "text": ">> She said, \"Marcus, you know your father"
  },
  {
    "start": "00:04:20.000",
    "end": "00:04:21.750",
    "start_seconds": 260.0,
    "end_seconds": 261.75,
    "text": ">> She said, \"Marcus, you know your father only wanted"
  },
  {
    "start": "00:04:21.750",
    "end": "00:04:21.760",
    "start_seconds": 261.75,
    "end_seconds": 261.76,
    "text": "only wanted"
  },
  {
    "start": "00:04:21.760",
    "end": "00:04:24.630",
    "start_seconds": 261.76,
    "end_seconds": 264.63,
    "text": "only wanted the best.\" She passing all these"
  },
  {
    "start": "00:04:24.630",
    "end": "00:04:24.640",
    "start_seconds": 264.63,
    "end_seconds": 264.64,
    "text": "the best.\" She passing all these"
  },
  {
    "start": "00:04:24.640",
    "end": "00:04:26.030",
    "start_seconds": 264.64,
    "end_seconds": 266.03,
    "text": "the best.\" She passing all these caskets."
  },
  {
    "start": "00:04:26.030",
    "end": "00:04:26.040",
    "start_seconds": 266.03,
    "end_seconds": 266.04,
    "text": "caskets."
  },
  {
    "start": "00:04:26.040",
    "end": "00:04:28.990",
    "start_seconds": 266.04,
    "end_seconds": 268.99,
    "text": "caskets. She get down to the $15,000"
  },
  {
    "start": "00:04:28.990",
    "end": "00:04:29.000",
    "start_seconds": 268.99,
    "end_seconds": 269.0,
    "text": "She get down to the $15,000"
  },
  {
    "start": "00:04:29.000",
    "end": "00:04:31.510",
    "start_seconds": 269.0,
    "end_seconds": 271.51,
    "text": "She get down to the $15,000 gold-plated casket and said, \"Marcus, I"
