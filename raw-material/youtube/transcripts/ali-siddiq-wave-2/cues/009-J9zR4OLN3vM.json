  {
    "start": "00:04:31.510",
    "end": "00:04:31.520",
    "start_seconds": 271.51,
    "end_seconds": 271.52,
    "text": "gold-plated casket and said, \"Marcus, I"
  },
  {
    "start": "00:04:31.520",
    "end": "00:04:33.950",
    "start_seconds": 271.52,
    "end_seconds": 273.95,
    "text": "gold-plated casket and said, \"Marcus, I believe this is the casket your father"
