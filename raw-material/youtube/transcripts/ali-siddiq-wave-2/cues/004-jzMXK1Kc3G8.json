  },
  {
    "start": "00:04:32.040",
    "end": "00:04:33.590",
    "start_seconds": 272.04,
    "end_seconds": 273.59000000000003,
    "text": "We get home."
  },
  {
    "start": "00:04:33.590",
    "end": "00:04:33.600",
    "start_seconds": 273.59000000000003,
    "end_seconds": 273.6,
    "text": "We get home."
  },
  {
    "start": "00:04:33.600",
    "end": "00:04:36.270",
    "start_seconds": 273.6,
    "end_seconds": 276.27,
    "text": "We get home. He come in there, \"Hey, man."
  },
  {
    "start": "00:04:36.270",
    "end": "00:04:36.280",
    "start_seconds": 276.27,
    "end_seconds": 276.28,
    "text": "He come in there, \"Hey, man."
  },
  {
    "start": "00:04:36.280",
    "end": "00:04:37.670",
    "start_seconds": 276.28,
    "end_seconds": 277.67,
    "text": "He come in there, \"Hey, man. Listen here."
  },
  {
    "start": "00:04:37.670",
    "end": "00:04:37.680",
    "start_seconds": 277.67,
    "end_seconds": 277.68,
    "text": "Listen here."
  },
  {
    "start": "00:04:37.680",
    "end": "00:04:39.310",
    "start_seconds": 277.68,
    "end_seconds": 279.31,
    "text": "Listen here. Don't have me come back down that god"
  },
  {
    "start": "00:04:39.310",
    "end": "00:04:39.320",
    "start_seconds": 279.31,
    "end_seconds": 279.32,
    "text": "Don't have me come back down that god"
  },
  {
    "start": "00:04:39.320",
    "end": "00:04:41.350",
    "start_seconds": 279.32,
    "end_seconds": 281.35,
    "text": "Don't have me come back down that god damn school. You take that candy and you"
  },
  {
    "start": "00:04:41.350",
    "end": "00:04:41.360",
    "start_seconds": 281.35,
    "end_seconds": 281.36,
    "text": "damn school. You take that candy and you"
  },
  {
    "start": "00:04:41.360",
    "end": "00:04:43.790",
    "start_seconds": 281.36,
    "end_seconds": 283.79,
    "text": "damn school. You take that candy and you sell that candy off premises if you need"
  },
  {
    "start": "00:04:43.790",
    "end": "00:04:43.800",
    "start_seconds": 283.79,
    "end_seconds": 283.8,
    "text": "sell that candy off premises if you need"
  },
  {
    "start": "00:04:43.800",
    "end": "00:04:46.990",
    "start_seconds": 283.8,
    "end_seconds": 286.99,
    "text": "sell that candy off premises if you need to sell some.\""
  },
  {
    "start": "00:04:47.000",
    "end": "00:04:48.870",
    "start_seconds": 287.0,
    "end_seconds": 288.87,
    "text": "All y'all be on the bus and walking home"
  },
  {
    "start": "00:04:48.870",
    "end": "00:04:48.880",
    "start_seconds": 288.87,
    "end_seconds": 288.88,
    "text": "All y'all be on the bus and walking home"
  },
  {
    "start": "00:04:48.880",
    "end": "00:04:50.190",
    "start_seconds": 288.88,
    "end_seconds": 290.19,
    "text": "All y'all be on the bus and walking home and You sell it to them on the bus"
  },
  {
    "start": "00:04:50.190",
    "end": "00:04:50.200",
    "start_seconds": 290.19,
    "end_seconds": 290.2,
    "text": "and You sell it to them on the bus"
  },
  {
    "start": "00:04:50.200",
    "end": "00:04:52.950",
    "start_seconds": 290.2,
    "end_seconds": 292.95,
    "text": "and You sell it to them on the bus and all that. And I said, \"Um"
  },
  {
    "start": "00:04:52.950",
    "end": "00:04:52.960",
    "start_seconds": 292.95,
    "end_seconds": 292.96,
    "text": "and all that. And I said, \"Um"
  },
  {
    "start": "00:04:52.960",
    "end": "00:04:55.270",
    "start_seconds": 292.96,
    "end_seconds": 295.27,
    "text": "and all that. And I said, \"Um hey,"
  },
  {
    "start": "00:04:55.270",
    "end": "00:04:55.280",
    "start_seconds": 295.27,
    "end_seconds": 295.28,
    "text": "hey,"
  },
  {
    "start": "00:04:55.280",
    "end": "00:05:05.550",
    "start_seconds": 295.28,
    "end_seconds": 305.55,
    "text": "hey, what about that bag of change?\""
  },
  {
    "start": "00:05:05.560",
    "end": "00:05:07.870",
    "start_seconds": 305.56,
    "end_seconds": 307.87,
    "text": "My daddy got tight with me. He came in,"
  },
  {
    "start": "00:05:07.870",
    "end": "00:05:07.880",
    "start_seconds": 307.87,
    "end_seconds": 307.88,
    "text": "My daddy got tight with me. He came in,"
  },
  {
    "start": "00:05:07.880",
    "end": "00:05:09.230",
    "start_seconds": 307.88,
    "end_seconds": 309.23,
    "text": "My daddy got tight with me. He came in, \"So, you want this little bag of change"
  },
  {
    "start": "00:05:09.230",
    "end": "00:05:09.240",
    "start_seconds": 309.23,
    "end_seconds": 309.24,
    "text": "\"So, you want this little bag of change"
  },
  {
    "start": "00:05:09.240",
    "end": "00:05:10.790",
    "start_seconds": 309.24,
    "end_seconds": 310.79,
    "text": "\"So, you want this little bag of change and"
  },
  {
    "start": "00:05:10.790",
    "end": "00:05:10.800",
    "start_seconds": 310.79,
    "end_seconds": 310.8,
    "text": "and"
  },
  {
    "start": "00:05:10.800",
    "end": "00:05:12.070",
    "start_seconds": 310.8,
    "end_seconds": 312.07,
    "text": "and Yeah, take your little own money. Take"
  },
  {
    "start": "00:05:12.070",
    "end": "00:05:12.080",
    "start_seconds": 312.07,
    "end_seconds": 312.08,
    "text": "Yeah, take your little own money. Take"
  },
  {
    "start": "00:05:12.080",
    "end": "00:05:13.470",
    "start_seconds": 312.08,
    "end_seconds": 313.47,
    "text": "Yeah, take your little own money. Take your little money. And don't ask me for"
  },
  {
    "start": "00:05:13.470",
    "end": "00:05:13.480",
    "start_seconds": 313.47,
    "end_seconds": 313.48,
    "text": "your little money. And don't ask me for"
  },
  {
    "start": "00:05:13.480",
    "end": "00:05:15.790",
    "start_seconds": 313.48,
    "end_seconds": 315.79,
    "text": "your little money. And don't ask me for no god damn lunch money.\""
  },
  {
    "start": "00:05:15.790",
    "end": "00:05:15.800",
    "start_seconds": 315.79,
    "end_seconds": 315.8,
    "text": "no god damn lunch money.\""
  },
  {
    "start": "00:05:15.800",
    "end": "00:05:20.110",
    "start_seconds": 315.8,
    "end_seconds": 320.11,
    "text": "no god damn lunch money.\" I said, \"I I hadn't been"
  },
  {
    "start": "00:05:20.120",
    "end": "00:05:22.230",
    "start_seconds": 320.12,
    "end_seconds": 322.23,
    "text": "asking you for lunch money.\" He said,"
  },
  {
    "start": "00:05:22.230",
    "end": "00:05:22.240",
    "start_seconds": 322.23,
    "end_seconds": 322.24,
    "text": "asking you for lunch money.\" He said,"
  },
  {
    "start": "00:05:22.240",
    "end": "00:05:23.750",
    "start_seconds": 322.24,
    "end_seconds": 323.75,
    "text": "asking you for lunch money.\" He said, \"Yeah, yeah, yeah, yeah. So, you ain't"
  },
  {
    "start": "00:05:23.750",
    "end": "00:05:23.760",
    "start_seconds": 323.75,
    "end_seconds": 323.76,
    "text": "\"Yeah, yeah, yeah, yeah. So, you ain't"
  },
  {
    "start": "00:05:23.760",
    "end": "00:05:25.310",
    "start_seconds": 323.76,
    "end_seconds": 325.31,
    "text": "\"Yeah, yeah, yeah, yeah. So, you ain't going to pay me nothing for my gas"
  },
  {
    "start": "00:05:25.310",
    "end": "00:05:25.320",
    "start_seconds": 325.31,
    "end_seconds": 325.32,
    "text": "going to pay me nothing for my gas"
  },
  {
    "start": "00:05:25.320",
    "end": "00:05:30.150",
    "start_seconds": 325.32,
    "end_seconds": 330.15,
    "text": "going to pay me nothing for my gas coming down here.\""
  },
  {
    "start": "00:05:30.160",
    "end": "00:05:31.390",
    "start_seconds": 330.16,
    "end_seconds": 331.39,
    "text": "He going to tell me, \"I'm the one got"
  },
  {
    "start": "00:05:31.390",
    "end": "00:05:31.400",
    "start_seconds": 331.39,
    "end_seconds": 331.4,
    "text": "He going to tell me, \"I'm the one got"
  },
  {
    "start": "00:05:31.400",
    "end": "00:05:40.470",
    "start_seconds": 331.4,
    "end_seconds": 340.47,
    "text": "He going to tell me, \"I'm the one got your money back.\""
  },
  {
    "start": "00:05:40.480",
    "end": "00:05:42.030",
    "start_seconds": 340.48,
    "end_seconds": 342.03,
    "text": "I said, \"How much you want?\" \"Shit, how"
  },
  {
    "start": "00:05:42.030",
    "end": "00:05:42.040",
    "start_seconds": 342.03,
    "end_seconds": 342.04,
    "text": "I said, \"How much you want?\" \"Shit, how"
  },
  {
    "start": "00:05:42.040",
    "end": "00:05:45.160",
    "start_seconds": 342.04,
    "end_seconds": 345.15999999999997,
    "text": "I said, \"How much you want?\" \"Shit, how much you willing to give me?\""
  }
]
